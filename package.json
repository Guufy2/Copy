{
  "name": "istu-student-help",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "nuxt dev --host 127.0.0.1",
    "build": "nuxt build",
    "preview": "nuxt preview --host 127.0.0.1",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "npm run lint && npm run format:check && npm run typecheck",
    "cms:init-env": "node scripts/init-env.mjs",
    "cms:up": "docker compose up -d --wait",
    "cms:down": "docker compose down",
    "cms:setup": "node --env-file=.env scripts/setup-directus.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:integration": "node --env-file=.env --test tests/cms.integration.test.mjs"
  },
  "dependencies": {
    "nuxt": "4.6.4",
    "sanitize-html": "^2.17.0",
    "vue": "^3.5.0",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/sanitize-html": "^2.16.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.0",
    "node": "24.15.0",
    "prettier": "^3.6.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vue-tsc": "^3.1.0"
  },
  "overrides": {
    "readdir-glob": {
      "minimatch": "^11.0.9"
    }
  }
}
